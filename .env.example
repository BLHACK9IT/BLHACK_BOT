# Twelve Data market-history provider
TWELVE_DATA_API_KEY=replace_with_your_twelve_data_key

# MetaTrader 5 account information (prefer the read-only/investor password)
MT5_LOGIN=12345678
MT5_PASSWORD=replace_with_your_investor_password
MT5_SERVER=YourBroker-Demo

# Optional: omit this if MetaTrader5 can locate the terminal automatically.
# MT5_TERMINAL_PATH=C:\\Program Files\\MetaTrader 5\\terminal64.exe
MT5_TIMEOUT_MS=60000

ENABLE_LIVE_STREAM=false
